// A read on every path doesn't decide a conflict with a read in progress, so
// a modify on some paths is undecided.
//
// CHECK-LABEL: sil [ossa] @summary_read_all_modify_some :
// CHECK:         alloc_box
// CHECK-LABEL: } // end sil function 'summary_read_all_modify_some'
sil [ossa] @summary_read_all_modify_some : $@convention(thin) (Builtin.Int1) -> () {
bb0(%0 : $Builtin.Int1):
  %box = alloc_box ${ var Builtin.Int32 }
  %addr = project_box %box : ${ var Builtin.Int32 }, 0
  %42 = integer_literal $Builtin.Int32, 42
  store %42 to [trivial] %addr : $*Builtin.Int32
  %f = function_ref @callee_read_all_modify_some : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  %a = apply %f(%0, %box) : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  destroy_value %box : ${ var Builtin.Int32 }
  %r = tuple ()
  return %r : $()
}

// The callee modifies on all paths, but the call it forwards the box to is
// undecided. An access in the callee may be in progress at that call.
//
// CHECK-LABEL: sil [ossa] @summary_forwards_to_may_modify :
// CHECK:         alloc_box
// CHECK-LABEL: } // end sil function 'summary_forwards_to_may_modify'
sil [ossa] @summary_forwards_to_may_modify : $@convention(thin) (Builtin.Int1) -> () {
bb0(%0 : $Builtin.Int1):
  %box = alloc_box ${ var Builtin.Int32 }
  %addr = project_box %box : ${ var Builtin.Int32 }, 0
  %42 = integer_literal $Builtin.Int32, 42
  store %42 to [trivial] %addr : $*Builtin.Int32
  %f = function_ref @callee_forwards_to_may_modify : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  %a = apply %f(%0, %box) : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  destroy_value %box : ${ var Builtin.Int32 }
  %r = tuple ()
  return %r : $()
}

// The callee throws, without modifying, on the error path.
//
// CHECK-LABEL: sil [ossa] @summary_throws_before_modify :
// CHECK:         alloc_box
// CHECK-LABEL: } // end sil function 'summary_throws_before_modify'
sil [ossa] @summary_throws_before_modify : $@convention(thin) () -> @error any Error {
bb0:
  %box = alloc_box ${ var Builtin.Int32 }
  %addr = project_box %box : ${ var Builtin.Int32 }, 0
  %42 = integer_literal $Builtin.Int32, 42
  store %42 to [trivial] %addr : $*Builtin.Int32
  %f = function_ref @callee_throws_before_modify : $@convention(thin) (@guaranteed { var Builtin.Int32 }) -> @error any Error
  try_apply %f(%box) : $@convention(thin) (@guaranteed { var Builtin.Int32 }) -> @error any Error, normal bb1, error bb2
bb1(%n : $()):
  destroy_value %box : ${ var Builtin.Int32 }
  %r = tuple ()
  return %r : $()
bb2(%e : @owned $any Error):
  destroy_value %box : ${ var Builtin.Int32 }
  throw %e : $any Error
}
