// A path that loops and then traps doesn't count. (A loop with no exit at
// all isn't valid SIL; the summary treats it like a trap.)
//
// CHECK-LABEL: sil [ossa] @summary_modify_else_loop :
// CHECK-NOT:     alloc_box
// CHECK-LABEL: } // end sil function 'summary_modify_else_loop'
sil [ossa] @summary_modify_else_loop : $@convention(thin) (Builtin.Int1) -> () {
bb0(%0 : $Builtin.Int1):
  %box = alloc_box ${ var Builtin.Int32 }
  %addr = project_box %box : ${ var Builtin.Int32 }, 0
  %42 = integer_literal $Builtin.Int32, 42
  store %42 to [trivial] %addr : $*Builtin.Int32
  %f = function_ref @callee_modify_else_loop : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  %a = apply %f(%0, %box) : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  destroy_value %box : ${ var Builtin.Int32 }
  %r = tuple ()
  return %r : $()
}

