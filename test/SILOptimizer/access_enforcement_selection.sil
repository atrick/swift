// The box escapes before the direct call, so the callee's accesses are dynamic.
//
// CHECK-LABEL: sil [ossa] @testBoxEscapesBeforeDirectCall : $@convention(thin) () -> Builtin.Int64 {
// CHECK: begin_access [read] [dynamic]
// CHECK-LABEL: } // end sil function 'testBoxEscapesBeforeDirectCall'
sil [ossa] @testBoxEscapesBeforeDirectCall : $@convention(thin) () -> Builtin.Int64 {
bb0:
  %box = alloc_box ${ var Builtin.Int64 }, var, name "x"
  %borrow = begin_borrow [lexical] [var_decl] %box : ${ var Builtin.Int64 }
  %proj = project_box %borrow : ${ var Builtin.Int64 }, 0
  %lit = integer_literal $Builtin.Int64, 1
  store %lit to [trivial] %proj : $*Builtin.Int64
  %closureF = function_ref @boxEscapingClosure : $@convention(thin) (@guaranteed { var Builtin.Int64 }) -> ()
  %copy = copy_value %borrow : ${ var Builtin.Int64 }
  %closure = partial_apply [callee_guaranteed] %closureF(%copy) : $@convention(thin) (@guaranteed { var Builtin.Int64 }) -> ()
  %escape = function_ref @takesEscapingClosure : $@convention(thin) (@owned @callee_guaranteed () -> ()) -> ()
  %c1 = apply %escape(%closure) : $@convention(thin) (@owned @callee_guaranteed () -> ()) -> ()
  %f = function_ref @boxCalleeAfterEscape : $@convention(thin) (@guaranteed { var Builtin.Int64 }) -> ()
  %c2 = apply %f(%borrow) : $@convention(thin) (@guaranteed { var Builtin.Int64 }) -> ()
  %read = begin_access [read] [unknown] %proj : $*Builtin.Int64
  %val = load [trivial] %read : $*Builtin.Int64
  end_access %read : $*Builtin.Int64
  end_borrow %borrow : ${ var Builtin.Int64 }
  destroy_value %box : ${ var Builtin.Int64 }
  return %val : $Builtin.Int64
}

sil @takesEscapingClosure : $@convention(thin) (@owned @callee_guaranteed () -> ()) -> ()

// CHECK-LABEL: sil private [ossa] @boxCalleeAfterEscape : $@convention(thin) (@guaranteed { var Builtin.Int64 }) -> () {
// CHECK: begin_access [modify] [dynamic]
// CHECK-LABEL: } // end sil function 'boxCalleeAfterEscape'
