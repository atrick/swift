  return %v : $()
}

// CHECK-LABEL: sil private [ossa] @boxAndInoutCallee : $@convention(thin) (Builtin.Int1, @inout Builtin.Int64, @guaranteed { var Builtin.Int64 }) -> () {
// CHECK: begin_access [modify] [dynamic]
// CHECK-LABEL: } // end sil function 'boxAndInoutCallee'
sil private [ossa] @boxAndInoutCallee : $@convention(thin) (Builtin.Int1, @inout Builtin.Int64, @guaranteed { var Builtin.Int64 }) -> () {
bb0(%0 : $Builtin.Int1, %1 : $*Builtin.Int64, %2 : @guaranteed ${ var Builtin.Int64 }):
  cond_br %0, bb1, bb2

bb1:
  %proj = project_box %2 : ${ var Builtin.Int64 }, 0
  %lit = integer_literal $Builtin.Int64, 2
  %write = begin_access [modify] [unknown] %proj : $*Builtin.Int64
  assign %lit to %write : $*Builtin.Int64
  end_access %write : $*Builtin.Int64
  br bb3

bb2:
  br bb3

bb3:
  %v = tuple ()
  return %v : $()
}

